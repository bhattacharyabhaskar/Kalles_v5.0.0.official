f; background-color: #f6fff5; margin-bottom: 5px;\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1469/7362/files/hand-woven_245c9de2-4c0c-4207-81db-6b826019fc7a.webp?v=1747610113\" width=\"40\" height=\"40\" alt=\"Handwoven\">\n            <span style=\"font-weight: 600;\">Handwoven</span>\n          </li>\n        {%- endif -%}\n\n        {%- if work_value contains 'Hand Embroidery' -%}\n          <li style=\"display: flex; align-items: center; gap: 10px; padding: 5px 14px; border-radius: 8px; border: 2px solid #d5f2df; background-color: #f6fff5; margin-bottom: 6px;\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1469/7362/files/hand-stitched_1e8fc4c7-d53d-4308-bae3-9ddf0248fedb.webp?v=1747610113\" width=\"40\" height=\"40\" alt=\"Hand Embroidered\">\n            <span style=\"font-weight: 600;\">Hand Embroidered</span>\n          </li>\n        {%- endif -%}\n\n        {%- if work_value contains 'Hand Paint' -%}\n          <li style=\"display: flex; align-items: center; gap: 10px; padding: 5px 14px; border-radius: 8px; border: 2px solid #d5f2df; background-color: #f6fff5; margin-bottom: 6px;\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1469/7362/files/hand-painted_7b3bbdb2-3a9a-4e30-980f-da9cf87397a1.webp?v=1747610113\" width=\"40\" height=\"40\" alt=\"Hand Painted\">\n            <span style=\"font-weight: 600;\">Hand Painted</span>\n          </li>\n        {%- endif -%}\n\n        {%- if work_value contains 'Print' -%}\n          <li style=\"display: flex; align-items: center; gap: 10px; padding: 5px 14px; border-radius: 8px; border: 2px solid #d5f2df; background-color: #f6fff5; margin-bottom: 6px;\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1469/7362/files/printed_495e220b-a25e-4d94-b585-4eb282e1fde3.webp?v=1747610113\" width=\"40\" height=\"40\" alt=\"Printed\">\n            <span style=\"font-weight: 600;\">Printed</span>\n          </li>\n        {%- endif -%}\n\n        {%- for variant in product.