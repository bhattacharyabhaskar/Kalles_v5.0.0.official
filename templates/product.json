            "custom_liquid_TthpCj": {
              "type": "custom-liquid",
              "name": "DELIVERY",
              "settings": {
                "custom_liquid": "<div class=\"ivy-highlights-wrapper\" style=\"margin-bottom: 16px;  text-align: center; position: relative; \">\n    <h4 class=\"ivy-highlights-header\" style=\"display: inline-block; position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #fefaf8; z-index: 2; color: #4b0000; font-size: 1.4rem; font-weight: 700; text-transform: uppercase; padding: 6px 20px; border: 2px solid #b7499b; border-radius: 10px; font-family: 'Poppins', sans-serif; white-space: nowrap;\">\nEstimated delivery\n</h4>\n  \n\n<div id=\"shipping-timeline\"\n     data-product-type=\"{{ product.type | escape }}\"\n     data-shipping-code=\"{{ product.metafields.custom.shipping | default: '' | escape }}\">\n  <div class=\"timeline-ui\">\n    <div class=\"timeline-step\">\n      <div class=\"timeline-badge\"><span>1</span></div>\n      <div class=\"timeline-icon\"><i class=\"las la-shopping-bag\"></i></div>\n      <div class=\"timeline-label\">Order Placed</div>\n      <div class=\"timeline-date\" id=\"order-date\"></div>\n    </div>\n    <div class=\"timeline-connector\"><i class=\"las la-chevron-circle-right\"></i></div>\n    <div class=\"timeline-step\">\n      <div class=\"timeline-badge\"><span>2</span></div>\n      <div class=\"timeline-icon\"><i class=\"las la-plane-departure\"></i></div>\n      <div class=\"timeline-label\">On its way</div>\n      <div class=\"timeline-date\" id=\"shipping-date\"></div>\n    </div>\n    <div class=\"timeline-connector\"><i class=\"las la-chevron-circle-right\"></i></div>\n    <div class=\"timeline-step\">\n      <div class=\"timeline-badge\"><span>3</span></div>\n      <div class=\"timeline-icon\"><i class=\"las la-gift\"></i></div>\n      <div class=\"timeline-label\">Delivered</div>\n      <div class=\"timeline-date\" id=\"delivery-date\"></div>\n    </div>\n    <div class=\"customization-note\" id=\"customization-note\" style=\"display: none;\"></div>\n  </div>\n</div>\n</div>\n<style>\n.timeline-ui {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  border: 1.5px solid #b7499b;\n  border-radius: 10px;\n  padding: 30px 2px 4px;\n  margin-top: 10px;\n  background: #fff;\n  text-align: center;\n  gap: 0px;\n  position: relative;\n}\n.timeline-ui::before {\n  content: \"\";\n  position: absolute;\n  top: -1.5px; /* aligns with the border */\n  left: 50%;\n  transform: translateX(-50%);\n  width: calc(100% / 3); /* width of the cut — adjust as needed */\n  height: 2px;\n  background: #fefaf8; /* match background color */\n  z-index: 1;\n}\n.timeline-step {\n  flex: 1;\n  min-width: 70px;\n  position: relative;\n}\n.timeline-badge {\n  width: 20px;\n  height: 20px;\n  background-color: #b0173f;\n  color: #fff;\n  font-size: 11px;\n  font-weight: bold;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0 auto 4px;\n}\n.timeline-icon {\n  font-size: 28px;\n  color: #b0173f;\n  font-weight: 700;\n  margin-bottom: 2px;\n}\n.timeline-label {\n  font-weight: 600;\n  font-size: 14px;\n  margin-bottom: 1px;\n  color: #333;\n}\n.timeline-date {\n  font-size: 13px;\n  color: #000000;\n}\n.timeline-connector {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0.1;\n  font-size: 28px;\n  color: #d63a5e;\n}\n.customization-note {\n  flex-basis: 100%;\n  font-size: 11px;\n  text-align: center;\n  color: #222;\n  background: #f7f7f7;\n  padding: 4px 8px;\n  border-radius: 4px;\n  margin-top: 10px;\n}\n</style>\n\n<script>\nfunction addShippingBusinessDays(startDate, daysToAdd) {\n  let count = 0;\n  const result = new Date(startDate);\n  while (count < daysToAdd) {\n    result.setDate(result.getDate() + 1);\n    const day = result.getDay();\n    if (day !== 0 && day !== 6) count++;\n  }\n  return result;\n}\n\nfunction addDeliveryBusinessDays(startDate, daysToAdd) {\n  let count = 0;\n  const result = new Date(startDate);\n  while (count < daysToAdd) {\n    result.setDate(result.getDate() + 1);\n    if (result.getDay() !== 0) count++;\n  }\n  return result;\n}\n\nfunction formatDate(d) {\n  return d.toLocaleDateString(\"en-US\", { month: \"short\", day: \"2-digit\" });\n}\n\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const el = document.getElementById(\"shipping-timeline\");\n  const productType = el.dataset.productType;\n  const rawShippingCode = el.dataset.shippingCode?.trim() || '';\n\n  let shipMin = 1, shipMax = 2;\n  const rangeMatch = rawShippingCode.match(/:\\s*(\\d+)[^\\d]+(\\d+)/);\n  if (rangeMatch) {\n    shipMin = parseInt(rangeMatch[1]);\n    shipMax = parseInt(rangeMatch[2]);\n  } else if (productType === \"Dress\") {\n    shipMin = 11;\n    shipMax = 13;\n  }\n\n  const today = new Date();\n  const shipMinDate = addShippingBusinessDays(today, shipMin);\n  const shipMaxDate = addShippingBusinessDays(today, shipMax);\n  const deliveryMinDate = addDeliveryBusinessDays(shipMinDate, 3);\n  const deliveryMaxDate = addDeliveryBusinessDays(shipMaxDate, 4);\n\n  document.getElementById(\"order-date\").innerText = formatDate(today);\n  document.getElementById(\"shipping-date\").innerText = `${formatDate(shipMinDate)} – ${formatDate(shipMaxDate)}`;\n  document.getElementById(\"delivery-date\").innerText = `${formatDate(deliveryMinDate)} – ${formatDate(deliveryMaxDate)}`;\n\n  if (productType === \"Saree\") {\n    const noteEl = document.getElementById(\"customization-note\");\n    noteEl.style.display = \"block\";\n    noteEl.innerHTML = '<strong>Add 3–5 days for stitched blouse or pre-stitched saree.</strong>';\n  }\n});\n</script>"
              },
              "blocks": {}
            },
