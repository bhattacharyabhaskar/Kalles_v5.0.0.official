ottom: 6px;\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1469/7362/files/contrast_41c16f34-c484-4dc0-942e-e7fb084f512a.webp?v=1747610113\" width=\"40\" height=\"40\" alt=\"Contrast Blouse Piece\">\n            <span style=\"font-weight: 600;\">Contrast Blouse Piece</span>\n          </li>\n        {%- endif -%}\n\n        {%- if bp_value contains 'Matching' -%}\n          <li style=\"display: flex; align-items: center; gap: 10px; padding: 5px 14px; border-radius: 8px; border: 2px solid #dfe2e7; background-color: #f5f6f7; margin-bottom: 6px;\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1469/7362/files/matching_d62abb0d-7c6f-487c-90df-48567b2a2b8c.webp?v=1747610113\" width=\"40\" height=\"40\" alt=\"Matching Blouse Piece\">\n            <span style=\"font-weight: 600;\">Matching Blouse Piece</span>\n          </li>\n        {%- endif -%}\n\n        {%- if top_border != null -%}\n          <li style=\"display: flex; align-items: center; gap: 10px; padding: 5px 14px; border-radius: 8px; border: 2px solid #dfe2e7; background-color: #f5f6f7; margin-bottom: 6px;\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1469/7362/files/top-border-icon.jpg?v=1748972755\" width=\"40\" height=\"40\" alt=\"Top Border\">\n            <span style=\"font-weight: 600;\">Top Border Width: {{top_border.value}} / {{ top_border.value.value | times:2.54 | round: 2}} cm</span>\n          </li>\n        {%- endif -%}\n\n        {%- if bottom_border != null -%}\n          <li style=\"display: flex; align-items: center; gap: 10px; padding: 5px 14px; border-radius: 8px; border: 2px solid #dfe2e7; background-color: #f5f6f7; margin-bottom: 6px;\">\n            <img src=\"https://cdn.shopify.com/s/files/1/1469/7362/files/bottom-border-icon.jpg?v=1748972776\" width=\"40\" height=\"40\" alt=\"Bottom Border\">\n            <span style=\"font-weight: 600;\">Bottom Border Width: {{bottom_border.value}} / {{ bottom_border.value.value | times:2.54 | round: 2}} cm</span>\n          </li>\n        {%- endif -%}\n      </ul>\n<div class=\"sku-number\" id=\"customization-note\" style=\"display: block;\"><strong>SKU: {{ product.variants.first.sku }} </strong></div>\n\n  </div>\n    </div>\n   \n\n  <style>\n .ivy-highlights-wrapper {\n  text-align: center;\n  margin: 40px auto 20px;\n}\n\n.ivy-highlights-box {\n  position: relative;\n  border: 1.5px solid #b7499b;\n  border-radius: 10px;\n  background: #fff;\n  padding: 30px 10px 10px; /* leave space for label */\n}\n\n.ivy-highlights-header {\n  position: absolute;\n  top: 0;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background: #fefaf8;\n  color: #4b0000;\n  font-size: 1.4rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  padding: 6px 20px;\n  border: 2px solid #b7499b;\n  border-radius: 10px;\n  font-family: 'Poppins', sans-serif;\n  margin: 0;\n  z-index: 2;\n}\n.sku-number {\n  flex-basis: 100%;\n  font-size: 14px;\n  text-align: center;\n  color: #FF0000;\n  background: #f7f7f7;\n  padding: 4px 8px;\n  border-radius: 6px;\n  margin-top: 5px;\n}\n  </style>\n{%- endif -%}"
